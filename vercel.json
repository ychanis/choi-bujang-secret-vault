{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/",
      "transforms": [
        {
          "type": "response.headers",
          "op": "set",
          "target": {
            "key": "X-Content-Type-Options"
          },
          "args": "nosniff"
        }
      ],
      "continue": true
    }
  ]
}
